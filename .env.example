# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string (use a dev branch locally).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Secret used to sign session cookies (32+ random characters).
AUTH_SECRET=

# Anthropic API key used by the three agents.
ANTHROPIC_API_KEY=

# Optional: model and effort per agent (low | medium | high).
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_EFFORT_ORCHESTRATOR=medium
# AGENT_EFFORT_DEVELOP=medium
# AGENT_EFFORT_TESTING=low

# Optional: spending guards for the public demo.
# MAX_RUNS_PER_DAY=30
# MAX_RUNS_PER_USER_PER_DAY=10

# Demo user created by `npm run db:seed`.
SEED_USERNAME=speedparadigm
SEED_PASSWORD=
